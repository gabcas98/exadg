   pcout << std::endl << "FSI:" << std::endl;
-  partitioned_solver->print_iterations(pcout);
+  if(use_optimal_control())
+  {
+    double const n = std::max(1.0, double(oc_time_steps));
+    print_list_of_iterations(pcout,
